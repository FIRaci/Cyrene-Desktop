{
  "name": "cyrene-desktop",
  "version": "0.9.0",
  "description": "Cyrene Desktop — Next-Generation AI Desktop Companion & Live2D Assistant",
  "main": "dist/main/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build:skills": "tsc -p tsconfig.skills.json",
    "build:screenshot-helper": "node scripts/build-screenshot-helper.mjs",
    "verify:screenshot-helper": "node scripts/verify-screenshot-helper.mjs resources/bin/cyrene-screenshot.exe",
    "build": "npm run build:skills && npm run build:main && npm run build:preload && npm run build:renderer",
    "package:win:dir": "npm run build && npm run build:screenshot-helper && electron-builder --win --dir",
    "dev": "npm run build:skills && npm run build:main && npm run build:preload && concurrently \"vite\" \"cross-env VITE_DEV=1 electron .\"",
    "start": "electron .",
    "start:agent": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:music": "npm run build:main && node scripts/run-music-smoke.mjs",
    "build:sim": "tsc -p tsconfig.sim.json",
    "sim": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js",
    "sim:coffee": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=coffee",
    "sim:mix": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=mix",
    "sim:rescue": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=rescue",
    "sim:sweep": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=mix --rewardGain=3,5,7,10"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qr-image": "^3.2.11",
    "@types/turndown": "^5.0.6",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@lancedb/lancedb": "^0.30.0",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.1.23",
    "@langchain/google-genai": "^2.1.2",
    "@langchain/openai": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@ricky0123/vad-node": "^0.0.9",
    "@types/tar": "^6.1.13",
    "@types/ws": "^8.5.14",
    "archiver": "^7.0.1",
    "axios": "^1.13.5",
    "better-sqlite3": "^11.8.1",
    "bindings": "^1.5.0",
    "bottleneck": "^2.19.5",
    "chokidar": "^4.0.3",
    "cron-parser": "^5.5.0",
    "csv-parse": "^6.1.0",
    "dompurify": "^3.3.1",
    "docx": "^9.5.1",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.3.3",
    "fuzzy": "^0.1.3",
    "glob": "^11.0.6",
    "highlight.js": "^11.11.1",
    "html-entities": "^2.6.0",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.28",
    "markdown-it": "^14.1.0",
    "music-metadata": "^11.15.4",
    "natural": "^8.1.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.3",
    "officegen": "^0.6.5",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pdfmake": "^0.3.4",
    "pptxgenjs": "^3.12.0",
    "punycode": "^2.3.1",
    "qrcode": "^1.5.4",
    "tar": "^7.5.10",
    "turndown": "^7.2.2",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5"
  }
}
